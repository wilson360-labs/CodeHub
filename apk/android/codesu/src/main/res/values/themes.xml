<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CodeSu" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/codesu_accent</item>
        <item name="colorPrimaryVariant">@color/codesu_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/codesu_accent</item>
        <item name="colorSecondaryVariant">@color/codesu_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/codesu_accent_dark</item>
        <!-- Window background required by some Material widgets (BottomNavigationView). -->
        <item name="android:windowBackground">@color/codesu_background</item>
        <item name="android:colorBackground">@color/codesu_background</item>
        <item name="colorSurface">@color/codesu_surface</item>
        <item name="colorOnSurface">@color/codesu_text_primary</item>
        <item name="colorControlHighlight">@color/codesu_accent_soft</item>
        <!-- Customize your theme here. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>

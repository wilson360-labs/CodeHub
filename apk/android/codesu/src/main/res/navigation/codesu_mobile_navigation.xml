<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/codesu_mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.codehub.app.codesu.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/codesu_fragment_home" />

    <fragment
        android:id="@+id/navigation_excluded"
        android:name="com.codehub.app.codesu.ui.excluded.ExcludedFragment"
        android:label="@string/title_selection"
        tools:layout="@layout/fragment_excluded" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.codehub.app.codesu.ui.Settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />
</navigation>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".ui.engine.CodeEngineFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CodeEngine"
                    android:textColor="@color/codesu_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cinco perfiles para gama baja y media. Animaciones y brillo vuelven a su valor original. No se tocan datos, sesiones, CPU ni GPU."
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/engine_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Perfil actual: Equilibrado"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/engine_profiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/engine_profile_ultra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ultra ahorro"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/engine_profile_saver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ahorro de batería"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/engine_profile_adaptive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Batería adaptable"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/engine_profile_balanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Equilibrado"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/engine_profile_performance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rendimiento"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detección automática"
                    android:textColor="@color/codesu_text_primary"
                    android:textSize="18sp"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/codesu_status_dot" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Con la batería al 5% entra Ultra ahorro; al conectar el cargador o subir al 10% vuelve al perfil elegido. Al abrir un juego de la lista entra Rendimiento y al salir vuelve al perfil anterior."
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/engine_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Activar cambios automáticos por uso"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/engine_doze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doze forzado solo en Ultra ahorro (según ROM)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/engine_dnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No molestar mientras juegas"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/engine_dnd_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Permitir no molestar" />

                <TextView
                    android:id="@+id/engine_shizuku_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Shizuku: comprobando"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/engine_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Última aplicación: ninguna"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/engine_apply_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aplicar perfil ahora" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lista de juegos · perfiles por app"
                    android:textColor="@color/codesu_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Solo estos paquetes activan Rendimiento y se excluyen del cierre. Free Fire ya está incluido."
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/engine_games_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp"
                    android:textIsSelectable="true" />

                <EditText
                    android:id="@+id/engine_game_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="com.dts.freefiremax"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/engine_game_add"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Agregar" />

                    <Button
                        android:id="@+id/engine_game_remove"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Quitar" />
                </LinearLayout>

                <Button
                    android:id="@+id/engine_game_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Restablecer lista" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/codesu_debloater_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="@color/codesu_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/codesu_debloater_item_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Icono de app" />

        <CheckBox
            android:id="@+id/codesu_debloater_item_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="32dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/codesu_debloater_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:textColor="@color/codesu_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/codesu_debloater_item_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:textColor="@color/codesu_text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/codesu_debloater_item_badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minWidth="0dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/codesu_debloater_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:minWidth="0dp"
                android:textColor="@color/codesu_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/codesu_debloater_item_state"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Deshabilitar"
                android:textSize="10sp"
                app:cornerRadius="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/codesu_debloater_item_remove"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Retirar"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/codesu_debloater_item_info"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ver detalles"
            android:src="@drawable/codesu_ic_info" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

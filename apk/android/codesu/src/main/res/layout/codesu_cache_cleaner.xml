<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/codesu_background"
    android:paddingBottom="12dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/codesu_cache_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/codesu_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CODESU · ALMACENAMIENTO"
                android:textColor="@color/codesu_accent_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear · Anti-bloatware"
                    android:textColor="@color/codesu_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/codesu_cache_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/codesu_cache_refresh_background"
                    android:clickable="true"
                    android:contentDescription="Actualizar la lista de caché"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="100dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp">

                    <ImageView
                        android:id="@+id/codesu_cache_refresh_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription=""
                        android:src="@drawable/codesu_ic_refresh"
                        app:tint="@color/codesu_accent_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Actualizar"
                        android:textColor="@color/codesu_accent_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/codesu_cache_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Calculando caché…"
                android:textColor="@color/codesu_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/codesu_cache_success_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tasa de éxito: disponible después de la primera limpieza"
                android:textColor="@color/codesu_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/codesu_cache_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/codesu_cache_result_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:textColor="@color/codesu_accent_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/codesu_cache_safety_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Recomendable: caché >1 MB en apps no protegidas. No recomendable: servicios sensibles. Solo caché; nunca datos ni sesiones."
                android:textColor="@color/codesu_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/codesu_usage_access_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Permitir acceso al uso"
                android:textColor="@color/codesu_accent_text"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/codesu_cache_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/codesu_accent_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/codesu_cache_progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/codesu_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/codesu_cache_apps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingBottom="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/codesu_cache_header" />

    <ImageButton
        android:id="@+id/codesu_cache_clean_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/codesu_cache_fab_background"
        android:contentDescription="Medir y limpiar cachés mayores de 1 MB"
        android:elevation="8dp"
        android:padding="16dp"
        android:src="@drawable/codesu_ic_broom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/codesu_cache_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="28dp"
        android:text="Concede acceso al uso para consultar el tamaño de caché de las apps instaladas."
        android:textColor="@color/codesu_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/codesu_cache_header" />

</androidx.constraintlayout.widget.ConstraintLayout>

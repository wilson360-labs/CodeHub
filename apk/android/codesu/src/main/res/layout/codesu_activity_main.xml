<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/codesu_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/codesu_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/codesu_surface"
        android:layoutDirection="ltr"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_snow"
            app:tint="@color/codesu_accent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="CodeSu"
            android:textColor="@color/codesu_text_primary"
            android:textSize="18sp"
            android:letterSpacing="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/logo"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/search_layout"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginRight="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/codesu_result_surface"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/codesu_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/codesu_text_secondary" />

                <EditText
                    android:id="@+id/search_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/codesu_text_primary"
                    android:textColorHint="@color/codesu_text_muted"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/nav_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/codesu_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="4dp"
            android:layout_weight="1"
            android:background="@drawable/codesu_nav_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:duplicateParentState="true"
                android:src="@drawable/codesu_nav_home"
                app:tint="@color/codesu_nav_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Inicio"
                android:textColor="@color/codesu_nav_foreground"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_excluded"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="4dp"
            android:layout_weight="1"
            android:background="@drawable/codesu_nav_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:duplicateParentState="true"
                android:src="@drawable/codesu_nav_selection"
                app:tint="@color/codesu_nav_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Selección"
                android:textColor="@color/codesu_nav_foreground"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_code_engine"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="4dp"
            android:layout_weight="1"
            android:background="@drawable/codesu_nav_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:duplicateParentState="true"
                android:src="@drawable/codesu_nav_engine"
                app:tint="@color/codesu_nav_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Motor"
                android:textColor="@color/codesu_nav_foreground"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="4dp"
            android:layout_weight="1"
            android:background="@drawable/codesu_nav_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:duplicateParentState="true"
                android:src="@drawable/codesu_nav_settings"
                app:tint="@color/codesu_nav_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Ajustes"
                android:textColor="@color/codesu_nav_foreground"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_cache"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="4dp"
            android:layout_weight="1"
            android:background="@drawable/codesu_nav_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:duplicateParentState="true"
                android:src="@drawable/codesu_nav_cache"
                app:tint="@color/codesu_nav_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Caché"
                android:textColor="@color/codesu_nav_foreground"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_debloater"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="4dp"
            android:layout_weight="1"
            android:background="@drawable/codesu_nav_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:duplicateParentState="true"
                android:src="@drawable/codesu_nav_system"
                app:tint="@color/codesu_nav_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Sistema"
                android:textColor="@color/codesu_nav_foreground"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_activity_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/codesu_toolbar"
        app:navGraph="@navigation/codesu_mobile_navigation" />

</androidx.constraintlayout.widget.ConstraintLayout>

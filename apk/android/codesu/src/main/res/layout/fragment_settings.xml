<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".ui.Settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Tema de la app"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/theme_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/auto_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Automático"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/light_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Claro"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/dark_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Oscuro"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Servicio Shizuku"
                        android:textColor="@color/codesu_accent_text"
                        android:textSize="16sp"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/codesu_status_dot" />

                    <TextView
                        android:id="@+id/shizuku_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Comprobando acceso a Shizuku"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/shizuku_permission_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minHeight="44dp"
                    android:text="Comprobar" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Motor de cierre"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/killer_mode_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/root_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Root"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/shizuku_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shizuku"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/shizuku_plus_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shizuku+"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:justificationMode="inter_character"
                    android:text="Shizuku+ sigue siendo Shizuku estándar. Usa un UserService AIDL para más estabilidad en builds modificados."
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Nivel de cierre"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/kill_level_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/kill_level_soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Suave · pausa y mantiene notificaciones"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/kill_level_deep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profundo · detención completa"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/kill_level_killer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Agresivo · detiene y limpia recientes"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:justificationMode="inter_character"
                    android:text="Las apps en nivel suave vuelven a aparecer en la lista. No se han detenido por completo."
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Origen de la lista"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/list_mode_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/user_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Usuario · solo apps instaladas"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/launcher_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lanzador · solo apps iniciables"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/system_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sistema · todas las apps"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Modo de selección"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/selection_mode_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/exclude_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Excluir · no cerrar las seleccionadas"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/include_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Incluir · cerrar solo las seleccionadas"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Ocultar apps críticas"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <CheckBox
                    android:id="@+id/hide_kill_my_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocultar CodeSu"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/hide_default_launcher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocultar lanzador"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/hide_default_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocultar alarma"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/hide_default_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocultar teclado"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/hide_default_dialer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocultar teléfono"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/hide_default_sms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocultar SMS"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/hide_critical_system_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocultar sistema crítico"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Lista"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <CheckBox
                    android:id="@+id/show_pkgname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mostrar paquete"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/show_scroll_animation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Animar la lista"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/click_to_app_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tocar una app abre su info"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/long_click_to_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mantener pulsada copia el paquete"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Cierre automático"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <CheckBox
                    android:id="@+id/screen_off_auto_kill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cerrar al bloquear"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/screen_off_auto_kill_delay_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/screen_off_auto_kill_delay_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Espera: 5 minutos"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/screen_off_auto_kill_delay_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:max="15"
                        android:min="0"
                        android:progress="0" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/scheduled_auto_kill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cerrar a una hora"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/scheduled_auto_kill_time_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/scheduled_auto_kill_time_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Hora: 3:30"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/scheduled_auto_kill_time_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:max="47"
                        android:min="0"
                        android:progress="7" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:justificationMode="inter_character"
                    android:text="El cierre automático detiene apps sin confirmación. Puede perder datos sin guardar o interrumpir descargas. Úsalo con cuidado."
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="CodeEngine · detección automática"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Los perfiles se eligen en CodeEngine. Aquí solo se activa la detección: batería al 5% y juego en primer plano."
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/power_battery_saver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Batería al 5% · Ultra ahorro automático"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/power_game_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Juego en primer plano · rendimiento automático"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/power_mode_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Perfil actual: Equilibrado"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Copia y restauración"
                    android:textColor="@color/codesu_accent_text"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:justificationMode="inter_character"
                    android:text="Guarda tu selección y tus ajustes en el almacenamiento local, o recupéralos de una copia."
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backup_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:text="Copia"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restore_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="Restaurar"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/codesu_app_version"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de acceso directo completo de CodeHub (pantalla de inicio).
  Rejilla 3x3 con los nueve destinos de HomeShortcuts. Mismo patrón que
  weather_widget_info: previewImage clásico para Android 7-11 y
  previewLayout en vivo para Android 12+.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="165dp"
    android:minHeight="165dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:minResizeWidth="150dp"
    android:minResizeHeight="150dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick"
    android:previewImage="@drawable/quick_widget_background"
    android:previewLayout="@layout/widget_quick"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_quick_description">
</appwidget-provider>

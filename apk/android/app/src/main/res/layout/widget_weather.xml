<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de clima de CodeHub — rediseño ampliado.
  FrameLayout raíz: capa de fondo (ImageView con gradiente dinámico por
  clima vía setImageViewBitmap) + contenido vertical con header (ciudad +
  hora), temperatura grande con condición y sensación térmica, stats
  (humedad / viento), mini-forecast 3 días y barra inferior con botón
  refrescar (con animación de carga) + "actualizado".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ── Header: ciudad + hora de última actualización ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CodeHub"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- ── Fila principal: icono + temp + condición ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/widget_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🌤️"
                    android:textSize="32sp" />

                <!-- Emoji ANIMADO: AdapterViewFlipper alimentado por
                     WeatherWidgetAnimService (RemoteViewsService). El
                     sistema hace flip entre los frames del emoji sin usar
                     CPU de CodeHub. Mientras no hay frames, el TextView
                     widget_icon (empty view) muestra el emoji estático,
                     así el widget NUNCA queda sin icono. -->
                <AdapterViewFlipper
                    android:id="@+id/wx_anim_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:autoStart="true"
                    android:flipInterval="1800" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando…"
                    android:textColor="#F2FFFFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_feels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Stats: humedad / viento / lluvia · ráfagas / presión / UV ── -->
        <LinearLayout
            android:id="@+id/widget_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/widget_humidity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💧 --%"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_wind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💨 -- km/h"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_rain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌧️ --%"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stats_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_gust"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌬️ -- km/h"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_pressure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 -- hPa"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_uv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀️ UV --"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- ── Amanecer / atardecer ── -->
        <TextView
            android:id="@+id/widget_sun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            android:visibility="gone" />

        <!-- ── Separador sutil ── -->
        <!-- BUG CORREGIDO: un <View> suelto (android.view.View) NO está
             en la lista de clases que RemoteViews puede inflar en el
             proceso del launcher (solo soporta FrameLayout, LinearLayout,
             RelativeLayout, GridLayout, TextView, ImageView, ImageButton,
             ProgressBar y unos pocos más). Con un <View> ahí, el inflado
             completo del preview fallaba en el proceso del launcher (no
             en el de CodeHub) y Samsung/One UI mostraba su propio error
             genérico "No se pudo agregar el widget" en vez del preview.
             Se reemplaza por el truco estándar para dividers en widgets:
             un LinearLayout vacío con altura fija y color de fondo — se
             ve idéntico y sí está en la lista soportada. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_divider" />

        <!-- ── Mini-forecast 3 días ── -->
        <LinearLayout
            android:id="@+id/widget_forecast_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_forecast_d1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="3" />

            <TextView
                android:id="@+id/widget_forecast_d2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="3" />

            <TextView
                android:id="@+id/widget_forecast_d3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="3" />
        </LinearLayout>

        <!-- ── Barras de energía animadas ("shimmer"), una por día del
             forecast. ProgressBar indeterminate horizontal: la animación
             la dibuja el propio sistema en el proceso del launcher, sin
             coste de batería extra. Puro detalle de diseño "pro". ── -->
        <LinearLayout
            android:id="@+id/widget_energy_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <ProgressBar
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="true"
                android:indeterminateTint="#B3FFFFFF" />

            <ProgressBar
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="true"
                android:indeterminateTint="#80FFFFFF" />

            <ProgressBar
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="true"
                android:indeterminateTint="#4DFFFFFF" />
        </LinearLayout>

        <!-- ── Barra inferior: botón refrescar (animado) CENTRADO + actualizado ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipToPadding="false"
            android:layout_marginTop="4dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/widget_refresh_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:visibility="invisible" />

                <ImageButton
                    android:id="@+id/widget_refresh"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_popup_sync"
                    android:contentDescription="@string/widget_weather_description"
                    android:scaleType="fitCenter"
                    android:tint="@android:color/white"
                    android:visibility="visible" />
            </FrameLayout>

            <!-- Cronómetro EN VIVO: "Actualizado hace mm:ss" contando desde
                 el último refresh (Chronometer lo anima el propio sistema,
                 ticks cada segundo, sin alarmas de CodeHub). Hereda de
                 TextView, así que un setTextViewText externo tampoco rompe. -->
            <Chronometer
                android:id="@+id/widget_updated2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D9FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>

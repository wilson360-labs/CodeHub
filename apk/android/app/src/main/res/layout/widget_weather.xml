<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de clima de CodeHub — diseño One UI 8.5 para el launcher.

  Capas:
   1) ImageView con la escena dibujada en Canvas (cielo + sol/luna + nubes
      + lluvia/nieve/niebla), generada por WeatherWidgetProvider.
   2) Contenido: ciudad + hora, hero (temperatura + condición/sensación),
      franja horaria de 4 h, pronóstico de 3 días, detalles y footer con
      "actualizado hace…" + refrescar.

  El provider elige modo COMPACTO / MEDIO / COMPLETO según la altura real
  del widget (AppWidgetOptions) y oculta franjas para que nada se corte.
  Solo se usan vistas soportadas por RemoteViews (LinearLayout, TextView,
  ImageView, ProgressBar, Chronometer).

  Métricas (para que quepa desde 4x3 y sobre en 4x4):
   padding 10+8 · header 17 · hero flexible (46sp + línea) · horaria 52+4
   · 3 días 44+2 · detalles 12+2 · footer 20+2  → 173 dp fijos + hero.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- ── Header: ciudad + hora actual ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CodeHub"
                android:textColor="#0B2545"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#16324F"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- ── Hero: temperatura grande + línea condición · sensación.
             La ilustración (sol/luna/nubes) la pinta el fondo arriba a
             la derecha, sin tocar el texto. ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#0B2545"
                android:textSize="46sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_condition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cargando…"
                    android:textColor="#0B2545"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_feels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text=""
                    android:textColor="#16324F"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Franja horaria: 4 horas ── -->
        <LinearLayout
            android:id="@+id/widget_hourly"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_glass"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_h1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ahora"
                    android:textColor="#16324F"
                    android:textSize="9sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h1_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h1_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#0B2545"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_h2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#16324F"
                    android:textSize="9sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h2_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h2_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#0B2545"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_h3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#16324F"
                    android:textSize="9sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h3_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h3_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#0B2545"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_h4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#16324F"
                    android:textSize="9sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h4_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_h4_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#0B2545"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Pronóstico de 3 días ── -->
        <LinearLayout
            android:id="@+id/widget_daily"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_d1_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoy"
                    android:textColor="#16324F"
                    android:textSize="9sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_d1_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_d1_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--° / --°"
                    android:textColor="#0B2545"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_d2_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#16324F"
                    android:textSize="9sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_d2_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_d2_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--° / --°"
                    android:textColor="#0B2545"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_d3_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#16324F"
                    android:textSize="9sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_d3_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_d3_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--° / --°"
                    android:textColor="#0B2545"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Detalles: humedad · viento · lluvia ── -->
        <TextView
            android:id="@+id/widget_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Humedad --%  ·  Viento -- km/h"
            android:textColor="#16324F"
            android:textSize="9sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- ── Footer: actualizado hace… + refrescar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Chronometer
                android:id="@+id/widget_updated2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#16324F"
                android:textSize="9sp"
                android:maxLines="1" />

            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="↻"
                android:textColor="#1D4ED8"
                android:textSize="15sp"
                android:contentDescription="Actualizar clima" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

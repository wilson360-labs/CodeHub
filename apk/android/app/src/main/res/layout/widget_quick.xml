<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de acceso directo completo de CodeHub (pantalla de inicio).
  Estética One UI 8.5 con paleta AMOLED: negro puro, texto hueso,
  acentos terracota/salvia y tarjetas redondeadas. Rejilla 3x3 con los
  9 destinos de HomeShortcuts. Solo vistas soportadas por RemoteViews.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:includeFontPadding="false"
            android:id="@+id/quick_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CodeHub"
            android:textColor="#F4ECE1"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:includeFontPadding="false"
            android:id="@+id/quick_header_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accesos"
            android:textColor="#9DB99E"
            android:textSize="9sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Fila 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/quick_cell_wile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_wile"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_chat"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_wile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="JARVIS"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_cell_weather"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_weather"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_weather"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Clima"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_cell_apps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_apps"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_apps"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Mis apps"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fila 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/quick_cell_catalog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_catalog"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_catalog"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Apps"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_cell_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_tools"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_tools"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Herramientas"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_cell_codebeat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_codebeat"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_codebeat"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_codebeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="CodeBeat"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fila 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/quick_cell_codestream"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_codestream"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_codestream"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_codestream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="CodeStream"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_cell_codesu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_codesu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_codesu"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_codesu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="CodeSu"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_cell_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_cell_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/quick_icon_profile"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shortcut_profile"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/quick_label_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Perfil"
                android:textColor="#F4ECE1"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

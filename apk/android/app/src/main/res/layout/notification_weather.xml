<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget del clima EN el panel de notificaciones — vista EXPANDIDA (grande).
  Estilo One UI: tarjeta oscura con esquinas suaves (bg_notif_weather),
  header astro+ciudad+hora, temperatura grande, condición + sensación,
  pronóstico por horas (4 slots, astritos pintados) y fila de sismos.
  Colores fijos para contraste en tema claro y oscuro del sistema.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_notif_weather">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/n_w_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:layout_marginStart="9dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_w_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/n_w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="10sp"
            android:textColor="#FF6B7380" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/n_w_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingEnd="2dp"
            android:textSize="34sp"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_w_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:textSize="12sp"
                android:textColor="#FFC6CFE0" />

            <TextView
                android:id="@+id/n_w_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:minWidth="0dp"
                android:textSize="10sp"
                android:textColor="#FF94A0B4" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_w_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/n_w_h1_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/n_w_h1_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textColor="#FFE6EBF5" />

            <TextView
                android:id="@+id/n_w_h1_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="9sp"
                android:textColor="#FF6B7380" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/n_w_h2_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/n_w_h2_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textColor="#FFE6EBF5" />

            <TextView
                android:id="@+id/n_w_h2_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="9sp"
                android:textColor="#FF6B7380" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/n_w_h3_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/n_w_h3_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textColor="#FFE6EBF5" />

            <TextView
                android:id="@+id/n_w_h3_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="9sp"
                android:textColor="#FF6B7380" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/n_w_h4_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/n_w_h4_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textColor="#FFE6EBF5" />

            <TextView
                android:id="@+id/n_w_h4_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="9sp"
                android:textColor="#FF6B7380" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/n_w_quake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="6dp"
        android:minWidth="0dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:textSize="11sp"
        android:textColor="#FFFF9B8A" />
</LinearLayout>

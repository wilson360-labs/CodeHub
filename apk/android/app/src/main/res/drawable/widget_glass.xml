<?xml version="1.0" encoding="utf-8"?>
<!-- Velo neutro para la franja horaria: negro casi puro + borde hueso tenue.
     Un solo drawable evita cambiar recursos por reflexión en RemoteViews. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="#E608080A" />
    <stroke
        android:width="1dp"
        android:color="#14F4ECE1" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Celda del widget de acceso directo: tarjeta AMOLED redondeada con
    retroalimentación terracota tenue. El launcher dibuja el ripple al pulsar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2AD98A67">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0A0A0C" />
            <stroke android:width="1dp" android:color="#33D98A67" />
        </shape>
    </item>
</ripple>

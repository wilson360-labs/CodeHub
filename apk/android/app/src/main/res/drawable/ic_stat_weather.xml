<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de estado del widget de clima: sol entre nubes (parcialmente
     nublado). Monocromo blanco — el sistema lo tinta.
     Métrica estándar de iconos de notificación: grilla 24dp con el arte
     ADENTRO del área segura (~2dp de margen por lado). La versión anterior
     tocaba ambos bordes y se veía recortada/encimida en la barra. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Rayos del sol (los 3 inferiores los tapa la nube): r 4.0→5.2 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M7.6,3.5V2.3 M3.6,7.5H2.4 M11.6,7.5H12.8 M4.77,4.67L3.92,3.82 M10.43,4.67L11.28,3.82" />

    <!-- Sol: círculo r2.7 centrado en (7.6, 7.5) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6,10.2 a2.7,2.7 0 1 1 0,-5.4 a2.7,2.7 0 1 1 0,5.4 z" />

    <!-- Nube: geometría Material probada, escalada 0.62 al área segura -->
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="7.2"
        android:translateY="8.6">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.64,-4.96z" />
    </group>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo base del widget de clima (respaldo y preview del selector).
  El provider lo cubre con una escena dibujada en Canvas según la
  condición y el momento del día. Este degradado claro de día coincide
  con la paleta y deja legible el texto en tinta oscura si la escena
  aún no se ha pintado.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFA9D8FF"
        android:centerColor="#FFCFE9FF"
        android:endColor="#FFEDF8FF" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>

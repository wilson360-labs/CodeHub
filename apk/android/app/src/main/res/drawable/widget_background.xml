<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo base del widget de clima. El provider lo sustituye dinámicamente
  (setInt/setBitmap) por un gradiente generado en código según la
  condición meteorológica y el momento del día, pero este queda como
  respaldo mientras no hay datos aún.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#FF3B82F6"
        android:centerColor="#FF2563EB"
        android:endColor="#FF0E1420" />
    <corners android:radius="20dp" />
    <stroke android:width="1.5dp" android:color="#55FFFFFF" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo base del widget de clima (respaldo y preview del selector).
  AMOLED: negro puro, borde terracota tenue. El provider cubre esta base
  con una escena vectorial dibujada en Canvas según la condición.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF000000" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#33D98A67" />
</shape>

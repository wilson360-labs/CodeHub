# CodeHub Telegram Bot — Variables de entorno
# Copia este archivo como .env y rellena los valores

# Token del bot (de @BotFather en Telegram)
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Tu chat ID (ejecuta: python telegram_bot.py --get-id)
TELEGRAM_CHAT_ID=123456789

# URL del backend Railway
BACKEND_URL=https://codehub-98s6.onrender.com

# Clave admin del backend
ADMIN_KEY=tu_clave_admin_aqui

# MongoDB (opcional, para stats extra)
# MONGODB_URI=mongodb+srv://...

# ── Telegram Alerts (backend/server.js) ──────────────────────
# El backend usa TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID (de arriba)
# para empujar alertas de seguridad y actividad al chat del admin.
# Activa/desactiva las alertas (true o false)
# TG_ALERTS_ENABLED=true
# Ventana para agrupar eventos repetidos en un solo mensaje (ms)
# TG_BURST_MS=4000
# Cada cuántas horas se envía el resumen periódico de estado
# TG_STATUS_HOURS=6

# ── Web Push (alertas de clima) ─────────────────────────────
# Notificaciones push al dispositivo cuando cambia el clima.
# Si no las pones, el backend usa el par de ejemplo de web-push
# (funciona igual; puedes generar el tuyo con: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# Tabla Supabase necesaria: ejecutar backend/push_subs.sql en el SQL Editor.

# ── Internet Archive (archive.org) ───────────────────────────
# Para APKs > 50 MB — Obtén las keys en: https://archive.org/account/s3.php
IA_ACCESS_KEY=tu_access_key_aqui
IA_SECRET_KEY=tu_secret_key_aqui
# El item debe existir previamente en tu cuenta de Archive.org
IA_ITEM_ID=codehub-apks

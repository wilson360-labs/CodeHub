# ─── Anthropic ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── MongoDB ─────────────────────────────────────────────
# Pega tu connection string de Atlas aquí
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/codehub?retryWrites=true&w=majority

# ─── Servidor ────────────────────────────────────────────
PORT=3001

# ─── Seguridad ───────────────────────────────────────────
# Dominio de tu frontend (GitHub Pages, tu VPS, etc.)
# Usa * solo para desarrollo local
ALLOWED_ORIGIN=https://tu-usuario.github.io

# ─── Rate limit ──────────────────────────────────────────
# Máximo de mensajes por IP cada 15 minutos
MAX_REQUESTS_PER_WINDOW=30
